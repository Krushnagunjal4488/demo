<!DOCTYPE html>
<html>
<head>

    <title>CRUD Application</title>

    <style>

        body{

            font-family: Arial;
            padding: 20px;

        }

        input{

            padding: 8px;
            margin: 5px;

        }

        button{

            padding: 8px 15px;
            margin: 5px;

        }

        table{

            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;

        }

        table, th, td{

            border: 1px solid black;
            padding: 10px;

        }

        a{

            text-decoration: none;
            color: red;

        }

    </style>

</head>

<body>

    <h1>CRUD Application</h1>

    <!-- Create Form -->

    <form action="/add" method="POST">

        <input
            type="text"
            name="name"
            placeholder="Enter Name"
            required
        >

        <input
            type="email"
            name="email"
            placeholder="Enter Email"
            required
        >

        <button type="submit">

            Add User

        </button>

    </form>

    <!-- Read Data -->

    <table>

        <tr>

            <th>Name</th>

            <th>Email</th>

            <th>Update</th>

            <th>Delete</th>

        </tr>

        <% users.forEach(user => { %>

            <tr>

                <form action="/update/<%= user._id %>" method="POST">

                    <td>

                        <input
                            type="text"
                            name="name"
                            value="<%= user.name %>"
                        >

                    </td>

                    <td>

                        <input
                            type="email"
                            name="email"
                            value="<%= user.email %>"
                        >

                    </td>

                    <td>

                        <button type="submit">

                            Update

                        </button>

                    </td>

                    <td>

                        <a href="/delete/<%= user._id %>">

                            Delete

                        </a>

                    </td>

                </form>

            </tr>

        <% }) %>

    </table>

</body>
</html>